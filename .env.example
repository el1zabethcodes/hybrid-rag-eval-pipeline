# Hybrid RAG Evaluation Pipeline — Environment Variables Reference
# Copy this file to .env and fill in real values. Never commit .env to version control.
# Nested settings use double-underscore as delimiter (pydantic-settings convention).

# ── YAML config override ──────────────────────────────────────────────────────
# Path to a YAML configuration file. When set, YAML values override .env defaults
# but are themselves overridable by the env vars below.
YAML_CONFIG_PATH=./config.yaml

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT__URL=http://localhost:6333
QDRANT__COLLECTION_NAME=rag_chunks
QDRANT__API_KEY=your-qdrant-api-key-here

# ── Dense Embedder ────────────────────────────────────────────────────────────
EMBEDDER__MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDER__VECTOR_DIM=384
EMBEDDER__BATCH_SIZE=64

# ── Sparse Encoder ────────────────────────────────────────────────────────────
SPARSE_ENCODER__MODEL_NAME=Qdrant/bm25

# ── Reranker ──────────────────────────────────────────────────────────────────
RERANKER__MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER__RERANK_TOP_K=5

# ── LLM Generator ────────────────────────────────────────────────────────────
LLM__PROVIDER=openai
LLM__MODEL_NAME=gpt-4o-mini
LLM__MAX_CONTEXT_TOKENS=4096
LLM__STREAM_RESPONSE=false
LLM__API_KEY=sk-your-openai-api-key-here
LLM__BASE_URL=

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL__DENSE_TOP_K=20
RETRIEVAL__SPARSE_TOP_K=20
RETRIEVAL__RETRIEVAL_TOP_K=10
RETRIEVAL__RRF_K=60

# ── Ingestion ─────────────────────────────────────────────────────────────────
INGESTION__CHUNK_SIZE=512
INGESTION__CHUNK_OVERLAP=64
INGESTION__INGESTION_BATCH_SIZE=100

# ── Evaluation ────────────────────────────────────────────────────────────────
EVALUATION__EVAL_OUTPUT_DIR=./eval_results
EVALUATION__EVAL_SAMPLE_SIZE=
EVALUATION__RANDOM_SEED=42
EVALUATION__JUDGE_LLM_PROVIDER=openai
EVALUATION__JUDGE_LLM_MODEL=gpt-4o-mini
RAGAS_LLM_API_KEY=sk-your-ragas-judge-api-key-here
EVALUATION__JUDGE_LLM_BASE_URL=
